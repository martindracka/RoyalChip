# --- Used by the Vue app (public values, safe to expose in the browser) ---
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=casino
VITE_APPWRITE_BUCKET_ID=game-images
VITE_APPWRITE_FUNCTION_ID=casino

# --- Used ONLY by the Node setup scripts in /scripts (never prefix with VITE_!) ---
# Create it in Appwrite Console -> Overview -> API keys.
APPWRITE_API_KEY=your-secret-server-api-key
